[Unit]
Description=Enable Intel Turbo Boost for the performance profile
After=power-profiles-daemon.service
ConditionPathExists=/sys/devices/system/cpu/intel_pstate/no_turbo

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/enable-intel-turbo

[Install]
# The power daemon starts after multi-user.target, so this service must not
# be ordered before that target through its default target dependencies.
WantedBy=graphical.target
