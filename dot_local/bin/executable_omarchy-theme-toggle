#!/usr/bin/env bash

set -euo pipefail

current_theme="$(omarchy theme current | tr '[:upper:] ' '[:lower:]-')"

if [[ "$current_theme" == "solitary-swift-in-endless-flight" ]]; then
  omarchy theme set solitary-swift-in-endless-flight-dark
else
  omarchy theme set solitary-swift-in-endless-flight
fi
