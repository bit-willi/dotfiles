#!/bin/bash

set -euo pipefail

plugin_dir="${HOME}/.config/omarchy/plugins"
plugin_prefix="${USER:-$(id -un)}"

anchor_popup() {
  local source_id="$1"
  local local_id="${plugin_prefix}.${source_id#omarchy.}"
  local target_dir="${plugin_dir}/${local_id}"
  local panel="${target_dir}/Panel.qml"

  if [[ ! -d "$target_dir" ]]; then
    omarchy plugin clone "$source_id"
  fi

  [[ -f "$panel" ]] || {
    echo "Missing panel for cloned plugin: $local_id" >&2
    return 1
  }

  sed -i 's/centerOnBar: true/centerOnBar: false/' "$panel"
  perl -0pi -e 's/if \(root\.bar && "centerHoverRevealSuppressed" in root\.bar\)\n      root\.bar\.centerHoverRevealSuppressed = value/if (root.bar \&\& typeof root.bar.setCenterHoverRevealSuppressed === "function")\n      root.bar.setCenterHoverRevealSuppressed(value)\n    else if (root.bar \&\& "centerHoverRevealSuppressed" in root.bar)\n      root.bar.centerHoverRevealSuppressed = value/g' "$panel"
  omarchy plugin enable "$local_id"
}

anchor_popup omarchy.clock
anchor_popup omarchy.weather
