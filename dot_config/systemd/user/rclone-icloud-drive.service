[Unit]
Description=Mount iCloud Drive with rclone
Documentation=https://rclone.org/iclouddrive/
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/Cloud/iCloudDrive %h/.cache/rclone/icloud-drive
ExecStart=/usr/bin/rclone mount icloud-drive: %h/Cloud/iCloudDrive \
    --config=%h/.config/rclone/icloud-drive.conf \
    --cache-dir=%h/.cache/rclone/icloud-drive \
    --vfs-cache-mode=full \
    --vfs-cache-max-size=8G \
    --vfs-cache-max-age=24h \
    --vfs-cache-min-free-space=10G \
    --vfs-cache-poll-interval=1m \
    --buffer-size=16M \
    --vfs-read-ahead=64M \
    --dir-cache-time=5m \
    --umask=077
ExecStop=/usr/bin/fusermount3 -uz %h/Cloud/iCloudDrive
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=default.target
