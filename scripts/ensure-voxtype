#!/usr/bin/env bash

set -euo pipefail

command -v voxtype >/dev/null || {
  echo "VoxType is required. Run make install-deps first." >&2
  exit 1
}

# Use the package's hardware-aware selector. It is idempotent and selects the
# Vulkan Whisper binary on this Intel laptop when the Vulkan runtime is present.
sudo voxtype setup gpu --enable

# Ensure the selected multilingual model exists and is active.
voxtype setup --download --model base --activate --no-post-install

systemctl --user daemon-reload
systemctl --user enable --now voxtype.service
